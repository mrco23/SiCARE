# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173

# Supabase project settings (server-side only)
# Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=
# Public/publishable key for Supabase Auth sign-up and sign-in. Never put a secret here.
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects (optional).
SUPABASE_ANON_KEY=
# Prefer a Supabase Secret API key (sb_secret_...).
# Never use a secret/service-role key in VITE_* variables or frontend code.
SUPABASE_SECRET_KEY=
# Legacy fallback for projects that still use the service_role JWT key.
# Set only if your project has no Secret API key; do not set both.
SUPABASE_SERVICE_ROLE_KEY=

# Fonnte token will be used in a later backend stage; keep it server-side.
FONNTE_TOKEN=
