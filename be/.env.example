# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated exact browser origins. Add your production frontend origin before deployment.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase project settings (server-side only)
# Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=
# Public/publishable key for Supabase Auth sign-up and sign-in. Never put a secret here.
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects (optional).
SUPABASE_ANON_KEY=
# Prefer a Supabase Secret API key (sb_secret_...).
# Never use a secret/service-role key in VITE_* variables or frontend code.
SUPABASE_SECRET_KEY=
# Legacy fallback for projects that still use the service_role JWT key.
# Set only if your project has no Secret API key; do not set both.
SUPABASE_SERVICE_ROLE_KEY=

# Fonnte WhatsApp API (server-side only)
# Never expose tokens or secrets to frontend.
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com
FONNTE_ENABLED=false
FONNTE_WEBHOOK_SECRET=
FONNTE_TIMEOUT_MS=15000

# WhatsApp Worker & Safety Controls
# WHATSAPP_SEND_ENABLED must remain false until explicitly enabled for live sending.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_MAX_ATTEMPTS=5
WHATSAPP_WORKER_CONCURRENCY=1
WHATSAPP_POLL_INTERVAL_MS=5000
# In test mode, messages are only sent to WHATSAPP_TEST_RECIPIENTS.
WHATSAPP_TEST_MODE=true
# Comma-separated E.164 phone numbers authorized for test sending (e.g. 6281234567890).
WHATSAPP_TEST_RECIPIENTS=

# Informed Consent & Invitations
# Dedicated AES-256-GCM encryption key (exactly 32 bytes, 64-character hexadecimal recommended).
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Mandatory in production environment. Never expose to frontend or log in plaintext.
CONSENT_ENCRYPTION_KEY=
# Canonical application base URL used for WhatsApp invitation links.
APP_BASE_URL=http://localhost:5173
