%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "primaryTextColor": "#000000", "primaryBorderColor": "#000000", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff", "nodeBorder": "#000000", "lineColor": "#000000", "textColor": "#000000", "titleColor": "#000000", "edgeLabelBackground": "#ffffff", "attributeBackgroundColorOdd": "#ffffff", "attributeBackgroundColorEven": "#ffffff"}, "themeCSS": ".relationshipLine { stroke: #000000 !important; } marker path, marker line { stroke: #000000 !important; } marker circle { stroke: #000000 !important; fill: #ffffff !important; }"}}%%
erDiagram
    pengguna_auth {
        uuid id PK
        varchar email "boleh kosong"
        varchar sandi_terenkripsi "boleh kosong"
        timestamptz email_dikonfirmasi_pada "boleh kosong"
        text telepon UK "boleh kosong"
        jsonb metadata_pengguna "boleh kosong"
        timestamptz login_terakhir_pada "boleh kosong"
    }
    motivasi_beranda {
        uuid id PK
        text isi "wajib"
        bool aktif "wajib"
    }
    profil {
        uuid id PK, FK
        text kode_identitas UK "boleh kosong"
        text nama_lengkap "wajib"
        text peran_aplikasi "wajib"
        text kategori_anggota "boleh kosong"
        text status_akun "wajib"
        text telepon_e164 "boleh kosong"
        text jenis_kelamin "boleh kosong"
        text nomor_siap "boleh kosong"
        text nomor_sipp_silp "boleh kosong"
        date sipp_silp_berlaku_hingga "boleh kosong"
        timestamptz sipp_silp_diperbarui_pada "boleh kosong"
    }
    profil_konselor {
        uuid id_profil PK, FK
        text nama_publik "boleh kosong"
        text judul_singkat "boleh kosong"
        text biografi "boleh kosong"
        text_array spesialisasi "wajib"
        int4 lama_pengalaman_tahun "boleh kosong"
        text path_foto "boleh kosong"
        bool tampil_publik "wajib"
        text hash_sandi_riwayat "boleh kosong"
        timestamptz sandi_riwayat_diperbarui_pada "boleh kosong"
    }
    periode_akademik {
        uuid id PK
        text tahun_akademik "wajib"
        text semester "wajib"
        date tanggal_mulai "wajib"
        date tanggal_selesai "wajib"
        bool dipublikasikan "wajib"
    }
    notifikasi {
        uuid id PK
        uuid id_penerima FK "wajib"
        text jenis "wajib"
        text judul "wajib"
        text isi "wajib"
        text jenis_entitas "boleh kosong"
        uuid id_entitas "boleh kosong"
        timestamptz dibaca_pada "boleh kosong"
    }
    logo_beranda {
        int2 id PK
        text path_penyimpanan "wajib"
        text teks_alternatif "wajib"
        uuid diperbarui_oleh FK "boleh kosong"
    }
    slot_ketersediaan {
        uuid id PK
        uuid id_konselor FK "wajib"
        uuid id_periode_akademik FK "boleh kosong"
        timestamptz waktu_mulai "wajib"
        timestamptz waktu_selesai "wajib"
        text status "wajib"
    }
    pemesanan {
        uuid id PK
        uuid id_klien FK "wajib"
        uuid id_konselor FK "wajib"
        uuid id_slot_ketersediaan FK "boleh kosong"
        text jenis_layanan "wajib"
        text nama_kelompok "boleh kosong"
        int4 jumlah_peserta "wajib"
        timestamptz waktu_mulai "wajib"
        timestamptz waktu_selesai "wajib"
        text status "wajib"
        text alasan_pembatalan "boleh kosong"
        text alasan_penjadwalan_ulang "boleh kosong"
        timestamptz kedaluwarsa_pada "boleh kosong"
        text alasan_kedaluwarsa "boleh kosong"
    }
    peserta_pemesanan {
        uuid id PK
        uuid id_pemesanan FK "wajib"
        text nama_tampilan "wajib"
        bool perwakilan "wajib"
        uuid id_pengguna FK "boleh kosong"
        text jenis_peserta "wajib"
        text nama_lengkap "boleh kosong"
        text fakultas "boleh kosong"
        text program_studi "boleh kosong"
        text nim "boleh kosong"
        text tempat_lahir "boleh kosong"
        date tanggal_lahir "boleh kosong"
        text jenis_kelamin "boleh kosong"
        text telepon_e164 "boleh kosong"
        bool peserta_utama "wajib"
        text status_peserta "wajib"
        text agama "boleh kosong"
        text pendidikan "boleh kosong"
        text alamat "boleh kosong"
    }
    intake_pemesanan {
        uuid id_pemesanan PK, FK
        uuid id_klien FK "wajib"
        jsonb jawaban "wajib"
    }
    sesi_konseling {
        uuid id PK
        uuid id_pemesanan FK, UK "wajib"
        uuid id_konselor FK "wajib"
        timestamptz waktu_mulai "wajib"
        timestamptz waktu_selesai "wajib"
        text status "wajib"
        text ruangan "boleh kosong"
        timestamptz dimulai_pada "boleh kosong"
        timestamptz diselesaikan_pada "boleh kosong"
        text alasan_tidak_hadir "boleh kosong"
        timestamptz tidak_hadir_pada "boleh kosong"
        timestamptz selesai_otomatis_pada "boleh kosong"
    }
    catatan_sesi {
        uuid id_sesi PK, FK
        uuid id_konselor FK "wajib"
        text catatan_konselor "boleh kosong"
        text catatan_klien "boleh kosong"
        text tindak_lanjut "boleh kosong"
    }
    umpan_balik {
        uuid id PK
        uuid id_sesi FK "wajib"
        uuid id_klien FK "wajib"
        uuid id_konselor FK "wajib"
        int2 penilaian "wajib"
        text komentar "boleh kosong"
        text status_moderasi "wajib"
        text status_tinjauan "wajib"
        text alasan_dinonaktifkan "boleh kosong"
    }
    persetujuan_konseling {
        uuid id PK
        uuid id_pemesanan FK "wajib"
        uuid id_sesi FK "boleh kosong"
        uuid id_peserta_pemesanan FK "wajib"
        text status "wajib"
        uuid id_penanda_tangan FK "boleh kosong"
        text nama_penanda_tangan "boleh kosong"
        jsonb data_identitas "wajib"
        text versi_pernyataan_persetujuan "wajib"
        timestamptz dilihat_pada "boleh kosong"
        timestamptz ditandatangani_pada "boleh kosong"
        timestamptz dicabut_pada "boleh kosong"
        text alasan_pencabutan "boleh kosong"
        text metode_tanda_tangan "boleh kosong"
        text path_tanda_tangan "boleh kosong"
        text path_dokumen_bertanda_tangan "boleh kosong"
        text sha256_dokumen_bertanda_tangan "boleh kosong"
        int8 ukuran_dokumen_bertanda_tangan_byte "boleh kosong"
    }

    pengguna_auth ||--o| profil : "memiliki profil"
    profil ||--o| profil_konselor : "memiliki profil konselor"
