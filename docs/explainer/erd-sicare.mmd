    pemesanan ||--o{ peserta_pemesanan : "melibatkan"
    profil |o--o{ peserta_pemesanan : "menjadi peserta"
    pemesanan ||--o| intake_pemesanan : "memiliki intake"
    profil ||--o{ intake_pemesanan : "mengisi"
    pemesanan ||--o| sesi_konseling : "menjadi sesi"
    profil ||--o{ sesi_konseling : "memimpin"
    sesi_konseling ||--o| catatan_sesi : "memiliki catatan"
    profil ||--o{ catatan_sesi : "menulis"
    sesi_konseling ||--o{ umpan_balik : "dinilai lewat"
    profil ||--o{ umpan_balik : "memberi"
    profil ||--o{ umpan_balik : "menerima"
    pemesanan ||--o{ persetujuan_konseling : "memerlukan"
    sesi_konseling |o--o{ persetujuan_konseling : "terkait"
    peserta_pemesanan ||--o{ persetujuan_konseling : "memberikan"
    profil |o--o{ persetujuan_konseling : "menandatangani"
