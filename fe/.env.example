# Frontend Supabase public/publishable key only; safe to expose to browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the publishable key (sb_publishable_...). The legacy anon key is also supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback for projects still using the anon JWT key.
VITE_SUPABASE_ANON_KEY=

# Base URL for the backend API, including /api/v1. Do not include a trailing slash.
# In production, set this to the publicly reachable backend URL.
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
